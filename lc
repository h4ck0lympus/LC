    "javascript": {"slug": "javascript", "ext": ".js",    "label": "JavaScript", "check": None},
    "typescript": {"slug": "typescript", "ext": ".ts",    "label": "TypeScript", "check": None},
    "kotlin":     {"slug": "kotlin",     "ext": ".kt",    "label": "Kotlin",     "check": None},
