#!/usr/bin/env python3
"""lc - test and push LeetCode solutions from the terminal.

  lc pull 547              fetch the stub and example testcases into 547/
  lc pull 547 --lang py    ...as 547/Solution.py (-l py and --lang=py work too)
  lc test 547              run 547/Solution.<ext> against 547/tests.txt
  lc push 547              push 547/Solution.<ext> for judging
  lc lang [name]           show or set the default language
  lc todo                  list problems tagged TODO / REVIEW

The problem number may be omitted when you are inside the problem directory.
The language comes from --lang, else $LC_LANG, else `lc lang`, else C++;
test and push pick it from the Solution.* file in the problem directory.
`// lc:local-begin` ... `// lc:local-end` blocks are never sent to LeetCode.
Session cookies live in ~/.config/lc/cookies.json; see `lc` with no arguments.
"""

import getpass
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

BASE = "https://leetcode.com"
UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
      "Chrome/124.0.0.0 Safari/537.36")
ROOT = Path(__file__).resolve().parent
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or "~/.config").expanduser() / "lc"
COOKIE_FILE = CONFIG / "cookies.json"
INDEX_FILE = CONFIG / "problems.json"
CONFIG_FILE = CONFIG / "config.json"

QUESTION_QUERY = """query q($titleSlug: String!) {
  question(titleSlug: $titleSlug) {
    questionId questionFrontendId title titleSlug exampleTestcaseList
    codeSnippets { langSlug code }
  }
}"""


class Fail(Exception):
    """A problem worth reporting to the user without a traceback."""


# ---------------------------------------------------------------- formatting

_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(code, text):
    return f"\033[{code}m{text}\033[0m" if _COLOR else text


def green(t):
    return c("32", t)


def red(t):
    return c("31", t)


def yellow(t):
    return c("33", t)


def dim(t):
    return c("2", t)


def bold(t):
    return c("1", t)


# ---------------------------------------------------------------- languages

